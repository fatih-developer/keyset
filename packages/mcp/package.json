{
  "name": "@keyset/mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server exposing Keyset Core capabilities to compatible agents.",
  "bin": {
    "keyset-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test"
  },
  "dependencies": { "@keyset/core": "*", "@keyset/provider-google": "*", "@keyset/adapter-better-auth": "*", "@keyset/adapter-authjs": "*" },
  "license": "MIT",
  "homepage": "https://keyset.fatihunal.dev",
  "repository": { "type": "git", "url": "https://github.com/fatih-developer/keyset.git" }
